# .env.example

# VeChain RPC endpoints
VECHAIN_TESTNET_RPC=https://rpc-testnet.vechain.energy
VECHAIN_MAINNET_RPC=https://rpc-mainnet.vechain.energy

# Deployer private key (for anchoring). Do NOT commit your real key.
# Use a dedicated deployer account with minimal funds for testnet.
# DEPLOYER_PRIVATE_KEY=0x...

# After deploying RootRegistry contract, set its address here for anchoring checks
# ROOT_REGISTRY=0x...

# Optional: port for backend
# PORT=3000

# Optional: enable UI host/port
# UI_PORT=3001
