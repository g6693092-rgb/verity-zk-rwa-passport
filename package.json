{
  "name": "verity-zk-rwa-passport",
  "version": "0.1.0",
  "description": "VeChain ZK attestation PoC - cold-chain + authenticity",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/server.ts",
    "merkle": "ts-node src/merkle.ts",
    "merkle:poseidon": "ts-node src/merkle_poseidon.ts",
    "compile-circuits": "echo 'Use circom to compile circuits in ./circuits'",
    "prove": "echo 'Use snarkjs to generate proof (see README)'",
    "verify-proof": "ts-node src/verify.ts",
    "deploy-testnet": "npx hardhat run --network vechainTestnet scripts/deploy.ts",
    "ci-compile": "bash scripts/run-cold-chain-proof.sh",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "smoke:test": "bash scripts/smoke-test.sh"
  },
  "keywords": [],
  "author": "g6693092-rgb",
  "license": "MIT",
  "dependencies": {
    "merkletreejs": "^0.3.25",
    "keccak256": "^1.0.6",
    "snarkjs": "^0.7.11",
    "ethers": "^5.7.2",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "circomlibjs": "^0.0.9"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "@nomiclabs/hardhat-ethers": "^2.1.1",
    "hardhat": "^2.15.0"
  }
}
